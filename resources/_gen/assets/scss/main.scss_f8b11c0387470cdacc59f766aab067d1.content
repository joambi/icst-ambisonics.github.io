a {
  text-decoration: none;
}
.theme--light a {
  color: #464646;
}
.theme--dark a {
  color: #eeeeee;
}
.theme--light a:hover {
  color: #6086b4;
}
.theme--dark a:hover {
  color: #6086b4;
}

blockquote {
  padding: 0 1em;
}
.theme--light blockquote {
  color: #464646;
  border-left: 1px solid #eeeeee;
}
.theme--dark blockquote {
  color: #eeeeee;
  border-left: 1px solid #464646;
}

p {
  line-height: 1.9em;
}

* {
  font-family: inherit;
}

body {
  font-family: "PingHei", "PingFang SC", "Helvetica Neue", "Work Sans", "Hiragino Sans GB", sans-serif;
  font-size: 1.6rem;
}

hr {
  border: 0;
  border-top: 1px solid #d5d5d5;
  height: 0;
}

.theme--dark hr {
  border-top-color: #5b5b5b;
}

.html {
  -webkit-font-smoothing: antialiased;
  font-size: 62.5%;
}

.body {
  width: 100%;
  margin: 0 auto;
}
.theme--light .body {
  color: #464646;
  background-color: #fff;
}
.theme--dark .body {
  color: #eeeeee;
  background-color: #152028;
}

.header {
  width: 100%;
  position: fixed;
  z-index: 1;
  top: 0;
}
.theme--light .header {
  background-color: #fff;
}
.theme--dark .header {
  background-color: #152028;
}
@media screen and (min-width: 961px) {
  .header {
    position: sticky;
  }
  .theme--light .header {
    border-bottom: 1px solid #eeeeee;
  }
  .theme--dark .header {
    border-bottom: 1px solid #464646;
  }
}
@media print {
  .header {
    display: none;
  }
}

.nav {
  display: none;
  max-height: 70vh;
  overflow-y: auto;
}
@media screen and (min-width: 961px) {
  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-shadow: none;
    max-height: none;
    overflow-y: visible;
  }
}
.nav__list {
  margin: 0;
  list-style: none;
  padding: 0;
  width: 100%;
}
.theme--light .nav__list {
  background-color: #eeeeee;
}
.theme--dark .nav__list {
  background-color: #464646;
}
@media screen and (min-width: 961px) {
  .nav__list {
    display: flex;
    padding: 24px 30px;
  }
  .theme--light .nav__list {
    background-color: #fff;
  }
  .theme--dark .nav__list {
    background-color: #152028;
  }
  .nav__list--end {
    flex-shrink: 1;
    justify-content: flex-end;
  }
}
.nav__list-item {
  padding: 12px 16px;
  text-transform: none;
  text-align: left;
  white-space: normal;
  line-height: 1.35;
}
@media screen and (min-width: 961px) {
  .nav__list-item {
    text-transform: uppercase;
    text-align: center;
    white-space: nowrap;
    padding-top: 0;
    padding-bottom: 0;
  }
  .nav__list-item:not(:last-child) {
    padding-right: 20px;
  }
}
.nav__link {
  display: inline-block;
  width: 100%;
}
.nav__link--active {
  font-weight: 700;
}
@media screen and (min-width: 961px) {
  .nav__link--active {
    padding-bottom: 24px;
  }
  .theme--light .nav__link--active {
    border-bottom: 1px solid #464646;
  }
  .theme--dark .nav__link--active {
    border-bottom: 1px solid #eeeeee;
  }
}
.theme--light .nav__list:not(.nav__list--end) .optionswitch__label {
  color: #6086b4;
}
.theme--dark .nav__list:not(.nav__list--end) .optionswitch__label {
  color: #6086b4;
}
.nav--active {
  display: block;
}

.animated {
  transition: top 0.8s linear;
  animation-duration: 1s;
  -webkit-animation-duration: 1s;
  -moz-animation-duration: 1s;
  -ms-animation-duration: 1s;
  -o-animation-duration: 1s;
  -webkit-animation-name: fadeInDown;
  -moz-animation-name: fadeInDown;
  -o-animation-name: fadeInDown;
  animation-name: fadeInDown;
}
@-webkit-keyframes fadeInDown {
  0% {
    -webkit-transform: translateY(-20px);
  }
  100% {
    -webkit-transform: translateY(0);
  }
}
@-moz-keyframes fadeInDown {
  0% {
    -moz-transform: translateY(-20px);
  }
  100% {
    -moz-transform: translateY(0);
  }
}
@-o-keyframes fadeInDown {
  0% {
    -o-transform: translateY(-20px);
  }
  100% {
    -o-transform: translateY(0);
  }
}
@keyframes fadeInDown {
  0% {
    transform: translateY(-20px);
  }
  100% {
    transform: translateY(0);
  }
}

.category {
  padding: 4px 6px;
  border-radius: 2px;
  display: inline-block;
  font-size: 1.4rem;
  margin: 5px 8px 5px 0;
}
.theme--light .category {
  border: 1px solid #eeeeee;
  background-color: #eeeeee;
  color: #464646 !important;
}
.theme--dark .category {
  border: 1px solid #464646;
  background-color: #464646;
  color: #eeeeee !important;
}

.tag {
  display: inline-block;
  font-size: 1.4rem;
  margin: 5px 8px 5px 0;
}
.theme--light .tag {
  color: #9f9f9f;
}
.theme--dark .tag {
  color: #9f9f9f;
}
.tag::before {
  content: "#";
}

.wrapper {
  display: flex;
  flex-direction: column;
}
@media screen and (min-width: 961px) {
  .wrapper {
    flex-direction: row;
  }
}
@media screen and (min-width: 1921px) {
  .wrapper {
    justify-content: center;
  }
}
.wrapper__main {
  width: 100%;
}
@media screen and (min-width: 961px) {
  .wrapper__main {
    width: 70%;
  }
}
@media screen and (min-width: 1921px) {
  .wrapper__main {
    width: 56%;
  }
}
.wrapper__main--fullscreen {
  margin-top: 20px;
}
@media screen and (min-width: 961px) {
  .wrapper__main--fullscreen {
    width: 100%;
    margin-top: 0px;
  }
}
@media screen and (min-width: 1921px) {
  .wrapper__main--fullscreen {
    width: 1920px;
  }
}
.wrapper__sidebar {
  width: 100%;
  padding: 16px 0;
}
@media screen and (min-width: 961px) {
  .wrapper__sidebar {
    width: 30%;
    padding: 0;
  }
}
@media screen and (min-width: 1921px) {
  .wrapper__sidebar {
    width: 24%;
  }
}
.wrapper__sidebar--hidden {
  display: none;
}

.sidebar {
  margin-top: 24px;
}
@media screen and (min-width: 961px) {
  .sidebar {
    z-index: 2;
    position: fixed;
    height: 100%;
    margin-top: 0;
    width: inherit;
    display: flex;
    flex-direction: column;
  }
  .theme--light .sidebar {
    margin-right: 4px;
    border-right: 1px solid #eeeeee;
  }
  .theme--dark .sidebar {
    margin-right: 4px;
    border-right: 1px solid #464646;
  }
}
.sidebar__content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
}
@media screen and (min-width: 961px) {
  .sidebar__content {
    flex-grow: 1;
    justify-content: flex-start;
    padding-top: 5.5rem;
  }
}
.sidebar__list {
  list-style: none;
  padding: 0;
  margin: 0.6rem 0 0;
  text-align: center;
}
.sidebar__list-item {
  display: inline;
  padding: 0 6px;
  line-height: 0;
}
.sidebar__introduction {
  top: 40%;
  text-align: center;
}
.sidebar__introduction-description {
  margin: 0 1em;
}
.sidebar__introduction-description p {
  line-height: 1.55;
}
.sidebar__introduction-profileimage {
  width: 138px;
  height: 138px;
  border-radius: 50%;
}
.sidebar__introduction-title {
  text-transform: uppercase;
  font-weight: bold;
  letter-spacing: 2px;
  line-height: 1;
  margin: 1em;
}
.sidebar__introduction-title a {
  font-size: 3.1rem;
}
.sidebar__introduction-title h1 {
  margin: 0;
}
.sidebar__social-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
.sidebar__social-image {
  height: 2.2rem;
  width: auto;
  vertical-align: middle;
  filter: var(--icon-filter, none);
}
.sidebar__social-icon {
  font-size: 3rem;
  line-height: 1;
}

.footer {
  text-align: center;
  margin: 0 auto;
  bottom: 0;
  width: 100%;
  padding-bottom: 20px;
  flex: 0;
  position: relative;
}
.footer__list {
  list-style: none;
  padding: 0;
  display: flex;
  justify-content: center;
}
.footer__item {
  font-size: 1.4rem;
}
.footer__item:not(:first-of-type)::before {
  content: "·";
  padding: 4px;
}
.footer__item a {
  font-size: 1.4rem;
}
.footer__sidebar {
  display: none;
}
@media screen and (min-width: 961px) {
  .footer__sidebar {
    display: block;
    width: 100%;
    margin-top: auto;
    padding-bottom: 26px;
  }
}
@media screen and (min-width: 961px) {
  .footer__base {
    display: none;
  }
}

.pagination {
  margin: 30px;
  padding: 0px 0 56px 0;
  text-align: center;
}
.pagination__list {
  list-style: none;
  margin: 0;
  padding: 0;
  height: 13px;
}
.pagination__list-item {
  margin: 0 2px 0 2px;
  display: inline;
  line-height: 1;
  text-decoration: none;
}
.theme--light .pagination__list-item {
  color: #464646;
}
.theme--dark .pagination__list-item {
  color: #eeeeee;
}

.navbar-burger {
  cursor: pointer;
  display: block;
  height: 3.25rem;
  position: relative;
  width: 3.25rem;
  margin-left: auto;
  padding: 6px;
}
.navbar-burger__line {
  display: block;
  height: 1px;
  left: calc(50% - 8px);
  position: absolute;
  transform-origin: center;
  transition-duration: 86ms;
  transition-property: background-color, opacity, transform;
  transition-timing-function: ease-out;
  width: 16px;
}
.theme--light .navbar-burger__line {
  background-color: #464646;
}
.theme--dark .navbar-burger__line {
  background-color: #eeeeee;
}
.navbar-burger__line:nth-child(1) {
  top: calc(50% - 6px);
}
.navbar-burger__line:nth-child(2) {
  top: calc(50% - 1px);
}
.navbar-burger__line:nth-child(3) {
  top: calc(50% + 4px);
}
@media screen and (min-width: 961px) {
  .navbar-burger {
    display: none;
  }
}

.comment {
  margin: 30px;
}
.comment .utterances {
  max-width: unset;
}

.optionswitch {
  position: relative;
}
.optionswitch__label {
  cursor: pointer;
  white-space: normal;
}
@media screen and (min-width: 961px) {
  .optionswitch__label {
    white-space: nowrap;
  }
}
.optionswitch__list {
  display: none;
  list-style: none;
  padding: 0;
  position: relative;
}
@media screen and (min-width: 961px) {
  .optionswitch__list {
    border-radius: 5px;
    position: absolute;
    top: 32px;
  }
  .theme--light .optionswitch__list {
    background: #eeeeee;
    box-shadow: 0 8px 16px rgba(10, 10, 10, 0.1);
  }
  .theme--dark .optionswitch__list {
    background: #464646;
    box-shadow: 0 8px 16px rgba(226, 226, 226, 0.1);
  }
}
.optionswitch__list-item {
  background: transparent;
  display: block;
  line-height: 1;
  bottom: 0;
  text-align: left;
  white-space: normal;
  padding-top: 10px;
  padding-left: 10px;
}
.theme--light .optionswitch__list-item {
  color: #464646;
}
.theme--dark .optionswitch__list-item {
  color: #eeeeee;
}
@media screen and (min-width: 961px) {
  .optionswitch__list-item {
    text-align: center;
    white-space: nowrap;
    padding-left: 12px;
    padding: 12px;
  }
}
.optionswitch__triangle {
  display: none;
}
.optionswitch__triangle::before {
  content: "";
  border-radius: 2px 0px 0px 0px;
  height: 14px;
  left: 25%;
  overflow: hidden;
  position: absolute;
  transform: rotate(45deg) translateY(0px) translatex(10px);
  width: 14px;
}
.theme--light .optionswitch__triangle::before {
  background: #eeeeee;
  box-shadow: 0 8px 16px rgba(10, 10, 10, 0.1);
  border-color: #eeeeee;
}
.theme--dark .optionswitch__triangle::before {
  background: #464646;
  box-shadow: 0 8px 16px rgba(226, 226, 226, 0.1);
  border-color: #464646;
}
.optionswitch__picker:checked ~ .optionswitch__list {
  display: block;
}
@media screen and (min-width: 961px) {
  .optionswitch__picker:checked ~ .optionswitch__triangle {
    display: block;
  }
}

.post {
  margin: 30px;
}
.theme--light .post {
  background-color: #fff;
}
.theme--dark .post {
  background-color: #152028;
}
.post__meta {
  display: flex;
  list-style: none;
  padding: 0;
}
.post__meta-item:not(:last-child) {
  margin-right: 1.25rem;
}
.post__meta-icon {
  margin-right: 2px;
}
.post__meta-text:not(:last-child) {
  margin-right: 4px;
}
.post__thumbnail {
  width: 100%;
  height: 15em;
  object-fit: cover;
  display: block;
}
.post__thumbnail-wrapper {
  border-radius: 2px;
  width: 100%;
  margin-bottom: 1em;
  overflow: hidden;
  transition: box-shadow 0.3s ease;
}
.theme--light .post__thumbnail-wrapper {
  box-shadow: 0 8px 16px rgba(10, 10, 10, 0.1);
}
.theme--dark .post__thumbnail-wrapper {
  box-shadow: 0 8px 16px rgba(226, 226, 226, 0.1);
}
.theme--light .post__content a {
  color: #6086b4;
}
.theme--dark .post__content a {
  color: #6086b4;
}
.theme--light .post__content .chroma {
  background-color: #eeeeee;
  display: block;
  border-bottom: 1px solid #eeeeee;
}
.theme--dark .post__content .chroma {
  background-color: #464646;
  display: block;
  border-bottom: 1px solid #464646;
}
.post__content code {
  font-family: monospace;
}
.post__content pre {
  padding: 5px;
  overflow-x: auto;
}
.theme--light .post__content pre {
  background-color: #eeeeee;
}
.theme--dark .post__content pre {
  background-color: #464646;
}
.post__content h1 {
  font-size: 3.6rem;
  letter-spacing: 1px;
  line-height: 1;
}
.post__content h1 a {
  font-size: 3.6rem;
}
.theme--light .post__content h1 a {
  color: #464646;
}
.theme--dark .post__content h1 a {
  color: #eeeeee;
}
.post__content h1 i {
  font-size: 3.6rem;
  vertical-align: middle;
  line-height: 1;
}
.post__content h2 {
  font-size: 2.4rem;
  font-weight: 600;
  letter-spacing: 1px;
  line-height: 1;
}
.post__content h2 a {
  font-size: 2.4rem;
}
.theme--light .post__content h2 a {
  color: #464646;
}
.theme--dark .post__content h2 a {
  color: #eeeeee;
}
.post__content h2 i {
  font-size: 2.4rem;
  vertical-align: middle;
  line-height: 1;
}
.post__content h3 {
  font-size: 2rem;
  font-weight: 600;
  letter-spacing: 1px;
  line-height: 1;
}
.post__content h3 a {
  font-size: 2rem;
}
.theme--light .post__content h3 a {
  color: #464646;
}
.theme--dark .post__content h3 a {
  color: #eeeeee;
}
.post__content h3 i {
  font-size: 2rem;
  vertical-align: middle;
  line-height: 1;
}
.post__content ul,
.post__content ol {
  line-height: 1.9em;
  font-weight: 400;
  word-wrap: break-word;
}
.post__content img {
  display: block;
  margin: 1.5em auto;
  max-width: min(100%, 720px);
  max-height: 520px;
  width: auto;
  height: auto;
  object-fit: contain;
  border-radius: 4px;
}
.post__content figure {
  max-width: 100%;
  height: auto;
  margin: 0 auto;
  text-align: center;
}
.post__content figure.big {
  max-width: 87.5%;
}
.post__content figure.medium {
  max-width: 75%;
}
.post__content figure.small {
  max-width: 50%;
}
.post__content figure.tiny {
  max-width: 25%;
}
@media screen and (min-width: 961px) {
  .post__content figure.right {
    max-width: 50%;
    float: right;
    margin: 0 0 0 1.5em;
  }
}
@media screen and (min-width: 961px) {
  .post__content figure.left {
    max-width: 50%;
    float: left;
    margin-right: 1.5em;
  }
}
.post__footer {
  padding: 12px 0;
}
.theme--light .post__footer {
  border-bottom: 1px solid #eeeeee;
}
.theme--dark .post__footer {
  border-bottom: 1px solid #464646;
}
.post__footer-date {
  font-size: 1.4rem;
  margin-right: 10px;
  margin-left: 5px;
}

.alert {
  padding: 1rem;
  border-style: solid;
  border-radius: 0.25rem;
  border-width: 2px;
  margin-top: 1rem;
}
.theme--light .alert {
  border-color: #ffc107;
}
.theme--dark .alert {
  border-color: #ffc107;
}
.alert__indicator {
  display: inline-block;
  border-radius: 9999px;
  padding: 0.5rem;
  width: 2.5rem;
  height: 2.5rem;
  text-align: center;
  font-weight: 800;
  margin-right: 0.75rem;
}
.theme--light .alert__indicator {
  color: #fff;
  background-color: #ffc107;
}
.theme--dark .alert__indicator {
  color: #152028;
  background-color: #ffc107;
}

.portfolio {
  position: relative;
  padding-left: 0px;
  padding-right: 0px;
  padding-bottom: 0px;
  padding-top: 48px;
}
@media screen and (min-width: 961px) {
  .portfolio {
    padding: 48px;
  }
}
.portfolio::before {
  content: "";
  position: absolute;
  top: 10%;
  left: 10%;
  bottom: 10%;
  right: 10%;
  background: transparent;
  border-radius: 0.5em;
}
@media screen and (min-width: 961px) {
  .theme--light .portfolio::before {
    border: 1px solid #eeeeee;
  }
  .theme--dark .portfolio::before {
    border: 1px solid #464646;
  }
}
.portfolio__title {
  letter-spacing: 1px;
  font-size: 2.6rem;
  line-height: 1;
  font-weight: 600;
}
.portfolio__image {
  max-width: 100%;
  min-width: 100%;
  box-shadow: 0 8px 16px rgba(226, 226, 226, 0.1);
  overflow: hidden;
  transition: box-shadow 0.3s ease;
  object-fit: cover;
  border-bottom: 0px;
  display: block;
  position: relative;
}
.portfolio__image-wrapper {
  display: block;
  background-color: #fff;
  position: relative;
  overflow: hidden;
}
.portfolio__image-wrapper--right, .portfolio__image-wrapper--left {
  margin-right: auto;
  margin-left: auto;
  width: calc(100% - 64px);
  padding: 32px 32px 0px 32px;
  max-width: inherit;
}
.theme--light .portfolio__image-wrapper--right, .theme--light .portfolio__image-wrapper--left {
  background-color: #fff;
}
.theme--dark .portfolio__image-wrapper--right, .theme--dark .portfolio__image-wrapper--left {
  background-color: #152028;
}
@media screen and (min-width: 961px) {
  .portfolio__image-wrapper--right, .portfolio__image-wrapper--left {
    width: 60%;
    object-fit: contain;
    max-width: none;
    border-radius: 0.5em;
    padding: 0;
  }
}
@media screen and (min-width: 961px) {
  .portfolio__image-wrapper--left {
    margin-right: auto;
    margin-left: 0;
  }
}
@media screen and (min-width: 961px) {
  .portfolio__image-wrapper--right {
    margin-right: 0;
    margin-left: auto;
  }
}
.portfolio__description {
  padding: 32px;
  position: relative;
}
.theme--light .portfolio__description {
  background-color: #fff;
}
.theme--dark .portfolio__description {
  background-color: #152028;
}
@media screen and (min-width: 961px) {
  .portfolio__description {
    padding: 48px;
    border-radius: 0.5em;
  }
  .theme--light .portfolio__description {
    box-shadow: 0 8px 16px rgba(10, 10, 10, 0.1);
  }
  .theme--dark .portfolio__description {
    box-shadow: 0 8px 16px rgba(226, 226, 226, 0.1);
  }
}
.portfolio__description--left, .portfolio__description--right {
  margin-top: -24px;
}
.theme--light .portfolio__description--left, .theme--light .portfolio__description--right {
  border-bottom: 1px solid #eeeeee;
}
.theme--dark .portfolio__description--left, .theme--dark .portfolio__description--right {
  border-bottom: 1px solid #464646;
}
@media screen and (min-width: 961px) {
  .portfolio__description--left, .portfolio__description--right {
    border-bottom: 0px;
    width: 60%;
    margin-top: -48px;
  }
  .theme--light .portfolio__description--left, .theme--light .portfolio__description--right {
    background: #eeeeee;
  }
  .theme--dark .portfolio__description--left, .theme--dark .portfolio__description--right {
    background: #464646;
  }
}
@media screen and (min-width: 961px) {
  .portfolio__description--right {
    margin-left: auto;
  }
}
.portfolio__meta {
  display: flex;
  flex-wrap: wrap;
  list-style: none;
  padding: 0;
  row-gap: 0.8rem;
}
.portfolio__meta-item:not(:last-child) {
  margin-right: 1.25rem;
}
.portfolio__button {
  font-weight: 400;
  display: inline-block;
  position: relative;
  outline: 0;
  background: transparent;
  text-align: center;
  text-decoration: none;
  cursor: pointer;
  white-space: nowrap;
  font-style: normal;
  border-radius: 999em;
  padding: 10px;
}
.theme--light .portfolio__button {
  border: 1px solid #9f9f9f;
  color: #6086b4;
}
.theme--dark .portfolio__button {
  border: 1px solid #9f9f9f;
  color: #6086b4;
}
.portfolio__button:hover {
  display: inline-block;
  position: relative;
  outline: 0px;
  background: transparent;
  text-align: center;
  text-decoration: none;
  cursor: pointer;
  white-space: nowrap;
  font-weight: 400;
  font-style: normal;
  border-radius: 999em;
}
.portfolio__button-wrapper {
  padding-bottom: 1em;
}

.page_404 {
  text-align: center;
  padding-top: 50px;
}

.archive {
  margin: 30px;
}
.archive__intro {
  margin: 0 0 1.6rem;
}
.archive__filters {
  display: flex;
  gap: 0.5rem;
  flex-wrap: wrap;
  margin: 0 0 1.2rem;
}
.archive__filter-btn {
  border-radius: 6px;
  padding: 0.35rem 0.75rem;
  font-size: 1.2rem;
  cursor: pointer;
  border: 1px solid;
}
.theme--light .archive__filter-btn {
  border-color: 1px solid #eeeeee;
  color: #464646;
}
.theme--dark .archive__filter-btn {
  border-color: 1px solid #464646;
  color: #eeeeee;
}
.theme--light .archive__filter-btn--active {
  border-color: #6086b4;
  color: #6086b4;
}
.theme--dark .archive__filter-btn--active {
  border-color: #6086b4;
  color: #6086b4;
}
.archive__recommended {
  margin: 0 0 1.4rem;
  padding: 0.8rem 1rem;
  border-radius: 6px;
}
.theme--light .archive__recommended {
  border: 1px solid 1px solid #eeeeee;
}
.theme--dark .archive__recommended {
  border: 1px solid 1px solid #464646;
}
.archive__recommended-title {
  font-size: 1.2rem;
  font-weight: 600;
  margin-bottom: 0.4rem;
}
.archive__recommended-list {
  margin: 0;
  padding-left: 1.2rem;
}
.archive__heading {
  font-size: 2.4rem;
  font-weight: 600;
  line-height: 2.2em;
}
.theme--light .archive__heading {
  color: #464646;
}
.theme--dark .archive__heading {
  color: #eeeeee;
}
.archive__list {
  padding: 0;
}
.archive__list-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 1.2rem;
  padding-bottom: 10px;
  list-style-type: none;
}
.archive__list-main {
  flex: 1;
  min-width: 0;
}
.archive__list-date {
  text-align: right;
  flex-shrink: 0;
}
.theme--light .archive__list-date {
  color: #9f9f9f;
}
.theme--dark .archive__list-date {
  color: #9f9f9f;
}
.archive__list .archive__readtime {
  margin-top: 0.2rem;
  font-size: 0.85em;
  opacity: 0.85;
}
.archive__list-title {
  display: inline-block;
  flex: 0.96;
}
.theme--light .archive__list-title {
  color: #464646;
}
.theme--dark .archive__list-title {
  color: #eeeeee;
}
.theme--light .archive__list-title:hover {
  color: #6086b4;
}
.theme--dark .archive__list-title:hover {
  color: #6086b4;
}
.archive__list-excerpt {
  font-size: 0.9em;
  margin-top: 0.2rem;
  line-height: 1.45;
}
.theme--light .archive__list-excerpt {
  color: #9f9f9f;
}
.theme--dark .archive__list-excerpt {
  color: #9f9f9f;
}
.archive__list-meta {
  margin-top: 0.35rem;
  font-size: 0.82em;
  opacity: 0.8;
}
.archive__keypoints {
  margin: 0.45rem 0 0.2rem 1.1rem;
  padding: 0;
  list-style: disc;
}
.archive__keypoints li {
  margin: 0.15rem 0;
  font-size: 0.9em;
  line-height: 1.35;
}

.notice {
  display: flex;
  flex-direction: column;
}
.theme--light .notice {
  background-color: rgb(191.4, 206.6, 225);
}
.theme--dark .notice {
  background-color: rgb(51, 72.8, 96);
}
.theme--light .notice--update {
  background-color: rgb(185.4, 239.4, 208.2);
}
.theme--dark .notice--update {
  background-color: rgb(45, 105.6, 79.2);
}
.theme--light .notice--warning {
  background-color: rgb(248.6, 187.8, 186.2);
}
.theme--dark .notice--warning {
  background-color: rgb(108.2, 54, 57.2);
}
.notice__title {
  background-color: #6086b4;
  align-self: flex-end;
  font-weight: 300;
  letter-spacing: 0.025em;
  padding: 0.2rem 0.5rem 0.2rem 0.5rem;
}
.theme--light .notice__title {
  color: #fff;
}
.theme--dark .notice__title {
  color: #152028;
}
.notice__title--update {
  background-color: #51d88a;
}
.notice__title--warning {
  background-color: #ef5753;
}
.notice__content {
  padding: 8px 8px 1rem 1rem;
}

.docs {
  display: flex;
  gap: 0;
  min-height: 60vh;
}
.docs__nav {
  display: none;
}
@media screen and (min-width: 961px) {
  .docs__nav {
    display: block;
    width: 210px;
    flex-shrink: 0;
    padding: 1.5rem 0 2rem;
    position: sticky;
    top: 0;
    max-height: 100vh;
    overflow-y: auto;
  }
  .theme--light .docs__nav {
    border-right: 1px solid #eeeeee;
  }
  .theme--dark .docs__nav {
    border-right: 1px solid #464646;
  }
}
.docs__nav-title {
  font-weight: 700;
  font-size: 1.3rem;
  padding: 0 1.2rem 1rem;
  margin-bottom: 0.5rem;
}
.theme--light .docs__nav-title {
  border-bottom: 1px solid #eeeeee;
}
.theme--dark .docs__nav-title {
  border-bottom: 1px solid #464646;
}
.docs__nav-title a {
  text-decoration: none;
}
.theme--light .docs__nav-title a {
  color: #464646;
}
.theme--dark .docs__nav-title a {
  color: #eeeeee;
}
.docs__nav-title a i {
  margin-right: 0.4rem;
}
.theme--light .docs__nav-title a i {
  color: #6086b4;
}
.theme--dark .docs__nav-title a i {
  color: #6086b4;
}
.docs__nav-list {
  list-style: none;
  padding: 0;
  margin: 0;
}
.docs__nav-item a {
  display: block;
  padding: 0.45rem 1.2rem;
  font-size: 1.3rem;
  text-decoration: none;
  border-left: 3px solid transparent;
  transition: all 0.15s ease;
}
.theme--light .docs__nav-item a {
  color: #9f9f9f;
}
.theme--dark .docs__nav-item a {
  color: #9f9f9f;
}
.theme--light .docs__nav-item a:hover {
  color: #464646;
  border-left-color: #eeeeee;
}
.theme--dark .docs__nav-item a:hover {
  color: #eeeeee;
  border-left-color: #464646;
}
.docs__nav-item--active a {
  font-weight: 600;
}
.theme--light .docs__nav-item--active a {
  color: #464646;
  border-left-color: #6086b4;
  background-color: #eeeeee;
}
.theme--dark .docs__nav-item--active a {
  color: #eeeeee;
  border-left-color: #6086b4;
  background-color: #464646;
}
.docs__content {
  flex: 1;
  min-width: 0;
}
@media screen and (min-width: 961px) {
  .docs__content {
    padding: 0 2rem;
  }
}
.docs__pagination {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  margin-top: 3rem;
  padding-top: 1.5rem;
}
.theme--light .docs__pagination {
  border-top: 1px solid #eeeeee;
}
.theme--dark .docs__pagination {
  border-top: 1px solid #464646;
}
.docs__pagination-link {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.6rem 1rem;
  font-size: 1.3rem;
  border-radius: 6px;
  text-decoration: none;
  max-width: 48%;
  transition: all 0.15s ease;
}
.theme--light .docs__pagination-link {
  color: #9f9f9f;
  border: 1px solid #eeeeee;
}
.theme--dark .docs__pagination-link {
  color: #9f9f9f;
  border: 1px solid #464646;
}
.theme--light .docs__pagination-link:hover {
  color: #464646;
  border-color: #6086b4;
}
.theme--dark .docs__pagination-link:hover {
  color: #eeeeee;
  border-color: #6086b4;
}
.docs__pagination-link--next {
  margin-left: auto;
  flex-direction: row-reverse;
  text-align: right;
}

.docs-index {
  margin: 0 30px 30px;
}
.docs-index__chapters {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
  margin-top: 1rem;
}
.docs-index__chapter {
  display: flex;
  align-items: center;
  gap: 1.2rem;
  padding: 1rem 1.4rem;
  border-radius: 8px;
  text-decoration: none;
  transition: all 0.15s ease;
}
.theme--light .docs-index__chapter {
  color: #464646;
  border: 1px solid #eeeeee;
  background-color: #fff;
}
.theme--dark .docs-index__chapter {
  color: #eeeeee;
  border: 1px solid #464646;
  background-color: #152028;
}
.docs-index__chapter:hover {
  transform: translateX(3px);
}
.theme--light .docs-index__chapter:hover {
  border-color: #6086b4;
}
.theme--dark .docs-index__chapter:hover {
  border-color: #6086b4;
}
.docs-index__chapter-number {
  width: 2.2rem;
  height: 2.2rem;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.2rem;
  font-weight: 700;
  flex-shrink: 0;
}
.theme--light .docs-index__chapter-number {
  background-color: #eeeeee;
  color: #464646;
}
.theme--dark .docs-index__chapter-number {
  background-color: #464646;
  color: #eeeeee;
}
.docs-index__chapter-info {
  flex: 1;
}
.docs-index__chapter-title {
  font-size: 1.5rem;
  font-weight: 600;
}
.docs-index__chapter-desc {
  font-size: 1.2rem;
  margin-top: 0.2rem;
}
.theme--light .docs-index__chapter-desc {
  color: #9f9f9f;
}
.theme--dark .docs-index__chapter-desc {
  color: #9f9f9f;
}
.docs-index__chapter-arrow {
  font-size: 1.2rem;
  flex-shrink: 0;
}
.theme--light .docs-index__chapter-arrow {
  color: #9f9f9f;
}
.theme--dark .docs-index__chapter-arrow {
  color: #9f9f9f;
}

.archive__list-title--featured {
  font-size: 2rem;
  font-weight: 700;
  padding-bottom: 0.8rem;
  margin-bottom: 0.5rem;
  display: block;
}
.theme--light .archive__list-title--featured {
  border-bottom: 1px solid #eeeeee;
}
.theme--dark .archive__list-title--featured {
  border-bottom: 1px solid #464646;
}

.post__content img:not([width]) {
  max-width: 700px;
  width: 100%;
  height: auto;
  display: block;
  margin: 1.5rem 0;
  border-radius: 4px;
}

.post__content img[width] {
  display: inline;
  vertical-align: middle;
  height: auto;
  border-radius: 2px;
  margin: 0 0.25em;
}

.callout {
  border-radius: 8px;
  padding: 1rem 1.4rem 1rem 1.2rem;
  margin: 1.5rem 0;
}
.theme--light .callout {
  background-color: #eeeeee;
}
.theme--dark .callout {
  background-color: #464646;
}
.callout__header {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-weight: 700;
  font-size: 1.5rem;
  margin-bottom: 0.6rem;
}
.callout__icon {
  font-size: 1.4rem;
  line-height: 1;
}
.callout__label {
  line-height: 1;
}
.callout__body {
  font-size: 1.5rem;
  line-height: 1.6;
}
.callout__body p {
  margin: 0;
}
.callout--tip {
  border-left: 3px solid #2ebac6;
}
.callout--tip .callout__label {
  color: #2ebac6;
}
.callout--note {
  border-left: 3px solid #6086b4;
}
.callout--note .callout__label {
  color: #6086b4;
}
.callout--info {
  border-left: 3px solid #6086b4;
}
.callout--info .callout__label {
  color: #6086b4;
}
.callout--warning {
  border-left: 3px solid #e0973a;
}
.callout--warning .callout__label {
  color: #e0973a;
}
.callout--important {
  border-left: 3px solid #d95f5f;
}
.callout--important .callout__label {
  color: #d95f5f;
}
.callout--todo {
  border-left: 3px solid #888;
}
.callout--todo .callout__label {
  color: #888;
}

.hero__links {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  margin-top: 1.8rem;
  margin-bottom: 0.5rem;
}

.hero__link {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.65rem 1.3rem;
  border-radius: 6px;
  font-size: 1.4rem;
  text-decoration: none;
  transition: all 0.15s ease;
}
.theme--light .hero__link {
  color: #464646;
  border: 1px solid #eeeeee;
  background-color: #fff;
}
.theme--dark .hero__link {
  color: #eeeeee;
  border: 1px solid #464646;
  background-color: #152028;
}
.theme--light .hero__link:hover {
  border-color: #6086b4;
  color: #6086b4;
}
.theme--dark .hero__link:hover {
  border-color: #6086b4;
  color: #6086b4;
}

.hero__links a.hero__link--primary {
  font-weight: 600;
  background-color: #6086b4;
  border-color: #6086b4;
  color: #ffffff;
}
.theme--light .hero__links a.hero__link--primary:hover {
  background-color: #464646;
  border-color: #464646;
  color: #fff;
}
.theme--dark .hero__links a.hero__link--primary:hover {
  background-color: #eeeeee;
  border-color: #eeeeee;
  color: #152028;
}

.home-cards {
  display: grid;
  gap: 1rem;
  margin: 1rem 0 1.25rem;
}

@media screen and (min-width: 961px) {
  .home-cards {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}
.home-card {
  padding: 1rem;
  border-radius: 10px;
}
.theme--light .home-card {
  background-color: #fff;
  border: 1px solid #eeeeee;
}
.theme--dark .home-card {
  background-color: #152028;
  border: 1px solid #464646;
}
.home-card h4 {
  margin: 0 0 0.5rem;
  line-height: 1.3;
}
.home-card p {
  margin: 0;
  font-size: 1.45rem;
  line-height: 1.55;
}

.home-card__actions,
.home-accordion__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem;
  margin-top: 0.9rem;
}

.home-accordion {
  margin: 0.75rem 0;
  border-radius: 10px;
  overflow: hidden;
}
.theme--light .home-accordion {
  border: 1px solid #eeeeee;
  background-color: #fff;
}
.theme--dark .home-accordion {
  border: 1px solid #464646;
  background-color: #152028;
}
.home-accordion summary {
  cursor: pointer;
  padding: 0.85rem 1rem;
  font-weight: 600;
}

.theme--light .home-accordion[open] summary {
  border-bottom: 1px solid #eeeeee;
}
.theme--dark .home-accordion[open] summary {
  border-bottom: 1px solid #464646;
}

.home-accordion__actions {
  padding: 0.85rem 1rem 1rem;
  margin-top: 0;
}

@media screen and (max-width: 700px) {
  .home-card__actions .hero__link,
  .home-accordion__actions .hero__link {
    width: 100%;
    justify-content: center;
  }
}
.medium-zoom-overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  opacity: 0;
  transition: opacity 300ms;
  will-change: opacity;
}
.theme--light .medium-zoom-overlay {
  background: #fff;
}
.theme--dark .medium-zoom-overlay {
  background: #152028;
}

.medium-zoom--opened .medium-zoom-overlay {
  cursor: pointer;
  cursor: zoom-out;
  opacity: 1;
}

.medium-zoom-image {
  cursor: pointer;
  cursor: zoom-in;
  transition: transform 300ms cubic-bezier(0.2, 0, 0.2, 1) !important;
  z-index: 100;
}

.medium-zoom-image--hidden {
  visibility: hidden;
}

.medium-zoom-image--opened {
  position: relative;
  cursor: pointer;
  cursor: zoom-out;
  will-change: transform;
}

/* (CONTACT) FORM */
.contact-form {
  margin-top: 30px;
}

.form-style {
  width: 100%;
}

.form-style ul {
  padding: 0;
  margin: 0;
  list-style: none;
}

.form-style ul li {
  display: block;
  margin-bottom: 10px;
  min-height: 35px;
}
.theme--light .form-style ul li {
  background-color: #fff;
  color: #464646;
}
.theme--dark .form-style ul li {
  background-color: #152028;
  color: #eeeeee;
}

.form-style ul li .field-style {
  box-sizing: border-box;
  -webkit-box-sizing: border-box;
  -moz-box-sizing: border-box;
  padding: 8px;
  outline: none;
  font-family: inherit;
}
.theme--light .form-style ul li .field-style {
  border: 1px solid #eeeeee;
  background-color: #fff;
  color: #464646;
}
.theme--dark .form-style ul li .field-style {
  border: 1px solid #464646;
  background-color: #152028;
  color: #eeeeee;
}

.form-style ul li .field-style:focus {
  box-shadow: 0 0 5px;
  border: 1px solid;
}

.form-style ul li .field-split {
  width: 49%;
}

.form-style ul li .field-full {
  width: 100%;
}

.form-style ul li input.align-left {
  float: left;
}

.form-style ul li input.align-right {
  float: right;
}

.form-style ul li textarea {
  width: 100%;
  height: auto;
}

.form-style ul li input[type=button],
.form-style ul li input[type=submit] {
  display: inline-block;
  cursor: pointer;
  text-decoration: none;
  width: 100%;
}

/* (CONTACT) FORM END */
#TableOfContents {
  display: block;
  background: transparent;
}

#TableOfContents ul {
  list-style: none;
  line-height: 1.9em;
  margin: 0;
}

#TableOfContents > ul {
  padding-left: 0;
}

#TableOfContents li a {
  display: inherit;
  color: #6086b4;
}

#TableOfContents li a:hover {
  display: inherit;
}

table {
  display: table;
  width: 80%;
  border-collapse: collapse;
}

tr {
  display: table-row;
}

th,
td {
  display: table-cell;
  padding: 8px;
}
.theme--light th,
.theme--light td {
  border: 1px solid #eeeeee;
}
.theme--dark th,
.theme--dark td {
  border: 1px solid #464646;
}