<CsoundSynthesizer>
<CsOptions>
-n -d 
</CsOptions>
<CsInstruments>
; Initialize the global variables. 
ksmps = 32
nchnls = 2
0dbfs = 1

instr 99

endin

</CsInstruments>
<CsScore>
i99 0 10
</CsScore>

</CsoundSynthesizer>
