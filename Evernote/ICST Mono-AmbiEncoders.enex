<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE en-export SYSTEM "http://xml.evernote.com/pub/evernote-export4.dtd">
<en-export export-date="20260304T123004Z" application="Evernote" version="11.3.4">
  <note>
    <title>ICST Mono-AmbiEncoders</title>
    <created>20221212T101804Z</created>
    <updated>20251221T180958Z</updated>
    <tag>published</tag>
    <note-attributes>
      <author>Johannes Schuett</author>
    </note-attributes>
    <content>
      <![CDATA[<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE en-note SYSTEM "http://xml.evernote.com/pub/enml2.dtd"><en-note><div style="display:none;--en-chs:&quot;&quot;"> </div><div><span style="font-family: &quot;Times New Roman&quot;;"><span style="font-size: 12px;"><span style="color:rgb(0, 0, 0);">Institute for Computer Music and Sound Technology / (ICST) </span>Zurich University of the Arts</span></span></div><hr/><div><span style="font-size: 18px;">ICST Mono-AmbiEncoder Signalflow</span></div><en-media style="--en-naturalWidth:2938; --en-naturalHeight:1962;" hash="eb2d50a73e5ddefe14693b578bd751af" type="image/png" /><div><span style="font-size: 18px;">You can find detailed information here: </span><b><a href="https://bitbucket.org/christian_schweizer/icst-ambisonics-plugins/wiki/Encoder_specification" rev="en_rl_none"><span style="color:rgb(24, 133, 226);--inversion-type-color:simple;">ICST AmbiEncoder_specification</span></a></b></div><hr/><h2 style="text-align:start;"><span style="color:rgb(23, 43, 77);">Radar</span></h2><div><span style="font-size: 18px;">The different possible radar zooms and views in Mono-AmbiEncoder.</span></div><en-media style="--en-naturalWidth:3642; --en-naturalHeight:1988;" hash="8d1e81c39709b5cbf060e15f16f5ff03" type="image/png" /><h2 style="text-align:start;"><span style="font-size: 18px;"><span style="color:rgb(23, 43, 77);">Radar Interaction</span></span></h2><ul><li><div style="text-align:start;"><span style="color:rgb(23, 43, 77);">see </span><a href="https://bitbucket.org/christian_schweizer/icst-ambisonics-plugins/wiki/Radar_Interaction/" rel="nofollow" rev="en_rl_none"><span style="color:rgb(24, 133, 226);--inversion-type-color:simple;">Radar Interaction</span></a></div></li></ul><hr/><h3>Mono-AmbiEncoder settings (Sources)</h3><en-media style="--en-naturalWidth:2646; --en-naturalHeight:966;" hash="3661f98865fe8de502e38ff76f7bc40c" type="image/png" /><h3 style="text-align:start;">Multi-AmbiEncoder settings  (Encoding)</h3><en-media style="--en-naturalWidth:3780; --en-naturalHeight:1544;" hash="ac5bd3530e23029a8f033b8bf49fbe7c" type="image/png" /><h3 style="text-align:start;"><span style="color:rgb(23, 43, 77);">Distance Encoding</span></h3><div style="text-align:start;"><span style="color:rgb(23, 43, 77);">Distance encoding is an optional feature and can be enabled/disabled using the first checkbox. Distance encoding presets can be saved and loaded independently from other presets. For more information, see </span><a href="https://bitbucket.org/christian_schweizer/icst-ambisonics-plugins/wiki/Distance_Encoding/" rel="nofollow" rev="en_rl_none"><span style="color:rgb(24, 133, 226);--inversion-type-color:simple;">Distance Encoding</span></a></div><hr/><h2 style="text-align:start;">Mono-AmbiEncoder (OSC)</h2><en-media style="--en-naturalWidth:1037; --en-naturalHeight:408;" hash="829a41f995a7c77e392bce18fd71e19d" type="image/png" /><div>See also here:<a href="https://bitbucket.org/christian_schweizer/icst-ambisonics-plugins/wiki/Encoder_specification" rev="en_rl_none">https://bitbucket.org/christian_schweizer/icst-ambisonics-plugins/wiki/Encoder_specification</a></div><div><br/></div><div><span style="font-size: 18px;">For tutorials on how to use the ICST Mono-AmbiEncoder, please check here:<span style="color:rgb(24, 133, 226);--inversion-type-color:simple;"> </span><a href="https://ambisonics.ch/post/tutorials" rev="en_rl_none"><span style="color:rgb(24, 133, 226);--inversion-type-color:simple;">Tutorials</span></a></span></div><hr/><div>&lt;&lt;<a href="https://icst-ambiplugins.postach.io/page/content" rev="en_rl_none"><span style="color:rgb(24, 133, 226);--inversion-type-color:simple;">Content</span></a></div></en-note>      ]]>
    </content>
